    "TEST_CONFIGS": {
        "python": {
            "enabled": true,
            "extension": ".py",
            "command": ["bash", "test_python.sh"],
            "timeout": 60
        },
        "php": {
            "enabled": true,
            "extension": ".php",
            "command": ["bash", "test_php.sh"],
            "timeout": 60
        },
        "bash": {
            "enabled": true,
            "extension": ".sh",
            "command": ["bash", "test_bash.sh"],
